# Environment Variables for Cloudflare Pages Deployment
# Replace placeholders with actual values from your Supabase and Cloudflare accounts

# Supabase Configuration
VITE_SUPABASE_URL=https://[YOUR_SUPABASE_PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
DATABASE_URL=postgresql://postgres:[YOUR_SUPABASE_PASSWORD]@[YOUR_SUPABASE_HOST]:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# Authentication
JWT_SECRET=[YOUR_JWT_SECRET]
OAUTH_SERVER_URL=https://[YOUR_SUPABASE_PROJECT_REF].supabase.co

# API Keys
OPENROUTER_API_KEY=[YOUR_OPENROUTER_API_KEY]
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]

# App Configuration
VITE_APP_ID=Affidavit