# Public browser configuration. These values are safe to expose only when they are the Supabase project URL and publishable/anon key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_APP_TITLE=Master Kanor Case
VITE_APP_URL=https://masterkanorcase.online
VITE_ADMIN_APP_URL=https://admin.masterkanorcase.online

# Supabase / server-only configuration. Never prefix private values with VITE_.
SUPABASE_SERVICE_ROLE_KEY=SET_IN_CLOUDFLARE_OR_SUPABASE_SECRET_STORE
SUPABASE_DB_URL=SET_ONLY_IN_MIGRATION_CI

# Cloudflare deployment and private storage. Never commit these values.
CLOUDFLARE_ACCOUNT_ID=SET_IN_GITHUB_ACTIONS_SECRET
CLOUDFLARE_API_TOKEN=SET_IN_GITHUB_ACTIONS_SECRET
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=case-evidence
R2_ACCESS_KEY_ID=SET_IN_SERVER_SECRET_STORE
R2_SECRET_ACCESS_KEY=SET_IN_SERVER_SECRET_STORE

# Optional server-side AI routing. Keep disabled until an authorized API boundary exists.
AI_ENABLED=false
GEMINI_API_KEY=SET_IN_SERVER_SECRET_STORE
OPENROUTER_API_KEY=SET_IN_SERVER_SECRET_STORE

# Production safety controls.
CORS_ALLOWED_ORIGIN=https://masterkanorcase.online
PUBLIC_CASE_ACCESS=false
