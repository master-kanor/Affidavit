# ============================================================================
# Open Connect AI Factory — Environment Template
# Copy to .env and fill in actual values. Never commit real secrets.
# ============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
APP_NAME=hillstreet-open-connect
APP_VERSION=1.0.0

# --- GitHub ---
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
GITHUB_OWNER=hillstreet-ph
GITHUB_REPO=open-connect

# --- Docker ---
DOCKER_HUB_USERNAME=YOUR_DOCKER_HUB_USERNAME
DOCKER_HUB_TOKEN=YOUR_DOCKER_HUB_TOKEN

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=case-evidence
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

# --- Supabase ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=mysql://user:password@host:3306/database

# --- Sentry ---
SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_ORG=hillstreet
SENTRY_PROJECT=open-connect

# --- Linear ---
LINEAR_API_KEY=YOUR_LINEAR_API_KEY
LINEAR_TEAM_ID=hillstreet-kai

# --- Notion ---
NOTION_TOKEN=YOUR_NOTION_INTEGRATION_TOKEN
NOTION_WORKSPACE_ID=YOUR_NOTION_WORKSPACE_ID

# --- Databricks ---
DATABRICKS_HOST=YOUR_DATABRICKS_HOST
DATABRICKS_TOKEN=YOUR_DATABRICKS_TOKEN

# --- Railway ---
RAILWAY_TOKEN=YOUR_RAILWAY_TOKEN
RAILWAY_PROJECT=master-runner

# --- Tencent Cloud (future migration) ---
TENCENT_SECRET_ID=YOUR_TENCENT_SECRET_ID
TENCENT_SECRET_KEY=YOUR_TENCENT_SECRET_KEY
TENCENT_REGION=ap-singapore-1

# --- OpenRouter ---
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# --- NVIDIA ---
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# --- OpenAI (ChatGPT, Codex) ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# --- Credential Vaults ---
ONEPASSWORD_SERVICE_ACCOUNT_TOKEN=YOUR_1PASSWORD_SERVICE_ACCOUNT_TOKEN
PROTON_PASS_API_KEY=YOUR_PROTON_PASS_API_KEY

# --- Composio ---
COMPOSIO_API_KEY=YOUR_COMPOSIO_API_KEY

# --- Open Connect ---
OPEN_CONNECT_TOKEN=YOUR_OPEN_CONNECT_TOKEN
OPEN_CONNECT_ENDPOINT=https://open-connect.hillstreet-ph.internal

# --- Cloud Execution ---
CLOUD_BROWSER_ENDPOINT=YOUR_CLOUD_BROWSER_ENDPOINT
CLOUD_COMPUTER_ENDPOINT=YOUR_CLOUD_COMPUTER_ENDPOINT

# --- AI Gateway Fallback ---
AI_ENABLED=true
AI_PROVIDER=kilo-code
AI_FALLBACK_CHAIN=kilo-code,open-code,openrouter,nvidia
AI_MAX_FREE_QUOTA_USD=0
AI_REQUIRE_APPROVAL_FOR_PAID=true

# --- Security ---
JWT_SECRET=GENERATE_STRONG_SECRET
COOKIE_SECRET=GENERATE_STRONG_SECRET
ENCRYPTION_KEY=GENERATE_32_BYTE_KEY

# --- CORS ---
CORS_ALLOWED_ORIGIN=http://localhost:3000,https://masterkanorcase.online,https://admin.masterkanorcase.online
